# Copy to /etc/alfadent/alfadent.env on the VPS. Never commit real values.
# Replace every placeholder. Keep file owner root:alfadent and mode 0640.

TELEGRAM_TOKEN=PASTE_NEW_TELEGRAM_BOT_TOKEN
MAX_BOT_TOKEN=PASTE_NEW_MAX_BOT_TOKEN
BITRIX24_WEBHOOK=https://YOUR_BITRIX_DOMAIN/rest/USER_ID/NEW_WEBHOOK/
INTERNAL_AUTH_SECRET=PASTE_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
MAX_WEBHOOK_SECRET=PASTE_LONG_RANDOM_MAX_WEBHOOK_SECRET
MAX_REQUIRE_WEBHOOK_SECRET=true

AUTH_API_URL=http://127.0.0.1:8001
AUTH_DB_PATH=/var/lib/alfadent/auth.sqlite3
BOT_DATA_DIR=/var/lib/alfadent/telegram
API_HOST=127.0.0.1
API_PORT=8001

WEBAPP_URL=https://YOUR_DOMAIN/miniapp.html
MAX_MINIAPP_LINK=https://YOUR_DOMAIN/miniapp.html
PROMOTIONS_URL=https://YOUR_DOMAIN/assets/promotions.json
INITDATA_MAX_AGE_SECONDS=3600

# Optional Telegram SOCKS5 proxy. Leave empty when not required.
TELEGRAM_PROXY=

# Optional/clinic-specific Bitrix settings.
BITRIX_ASSIGNED_BY_ID=33
LOG_LEVEL=INFO
