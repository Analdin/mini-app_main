[Unit]
Description=AlfaDent MAX webhook bot
After=network-online.target alfadent-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/alfadent/alfa-dent_max/max_bot
ExecStart=/opt/alfadent/venv-max/bin/python max_bot.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
