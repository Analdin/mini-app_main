[Unit]
Description=AlfaDent FastAPI Mini App and shared auth API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/alfadent/mini-app_main
ExecStart=/opt/alfadent/venv-app/bin/uvicorn webapp_api:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
